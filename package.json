{
  "name": "agentscene-builder-workspace",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "Agent-native parametric 3D modeling core with optional renderer and asset adapters.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "agentscene": "node packages/cli/src/agentscene.mjs",
    "component:list": "node scripts/model.mjs component list",
    "registry:check": "node scripts/registry.mjs",
    "registry:build": "node scripts/registry.mjs --write",
    "build:editor": "node scripts/build-app.mjs editor",
    "build:library": "node scripts/build-app.mjs library"
  },
  "workspaces": [
    "packages/*",
    "adapters/*",
    "apps/*"
  ],
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
