{
  "schemaVersion": "0.1",
  "id": "site.slotted-drain-grate",
  "version": "0.1.0",
  "kind": "component",
  "title": "条缝排水格栅",
  "summary": "实体边框之间有贯通长槽，宽度与槽数可调。",
  "license": "Apache-2.0",
  "semanticType": "site.drainage.grate",
  "capabilities": [
    "resize",
    "attach",
    "material"
  ],
  "tags": [
    "建筑",
    "室外",
    "基础构件",
    "排水"
