            },
            "geometry": {
              "type": "slotted-drain-grate",
              "length": 1.2,
              "width": 0.438,
              "thickness": 0.035,
              "frameWidth": 0.026,
              "barWidth": 0.018,
              "slotCount": 14
            }
          }
        ],
        "anchors": {
          "grate-bottom": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "grate-bottom"
            }
          },
          "start": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "start"
            }
          },
          "end": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "end"
            }
          }
        }
      }
