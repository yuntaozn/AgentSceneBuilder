      "unit": "m",
      "default": 1.2
    },
    "width": {
      "type": "number",
      "unit": "m",
      "default": 0.438
    },
    "thickness": {
      "type": "number",
      "unit": "m",
      "default": 0.035
    },
    "frameWidth": {
      "type": "number",
      "unit": "m",
      "default": 0.026
    },
    "barWidth": {
      "type": "number",
      "unit": "m",
      "default": 0.018
    },
    "slotCount": {
      "type": "number",
      "default": 14
    }
  },
  "anchors": [
    "grate-bottom",
    "start",
    "end"
