      "drive-angle",
      "link-trim",
      "cover-angle"
    ],
    "qualityChecks": [
      "驱动角变化时，连杆运动跟随曲柄。",
      "连杆末端销孔可单独定位。",
      "底座与电缆端保持固定。"
    ]
  },
