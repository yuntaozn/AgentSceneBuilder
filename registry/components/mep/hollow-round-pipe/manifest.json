{
  "schemaVersion": "0.1",
  "id": "mep.hollow-round-pipe",
  "version": "0.1.0",
  "kind": "component",
  "title": "中空圆管直段",
  "summary": "区分外径和壁厚的空心管材，两端的中心、方向和外径随几何更新。",
  "license": "Apache-2.0",
  "semanticType": "mep.pipe.hollow-straight",
  "capabilities": [
    "attach",
    "path-edit",
    "resize"
  ],
  "tags": [
    "基础构件",
    "MEP",
    "给排水",
    "管件"
  ],
  "parameters": {
    "outsideDiameter": {
      "type": "number",
      "unit": "m",
      "default": 0.11
    },
    "thickness": {
      "type": "number",
      "unit": "m",
      "default": 0.005
    }
  },
  "anchors": [
    "start",
    "end"
  ],
  "ai": {
    "intent": "生成给排水中的可对接管段。",
    "editableParts": [
      "调整路径、外径和壁厚。"
    ],
    "qualityChecks": [
      "管口外径可参与连接检查。"
    ]
  },
  "editor": {
    "document": {
      "id": "hollow-round-pipe",
      "component": "core.composition",
      "parameters": {
        "nodes": [
          {
            "id": "pipe",
            "semanticType": "mep.pipe.hollow-straight",
            "material": "pvc",
            "appearance": {
              "color": "#b7c0bd"
            },
            "geometry": {
              "type": "hollow-round-pipe",
              "points": [
                [0,0,0],
                [1.25,0,0]
              ],
              "up": [0,1,0],
              "outsideDiameter": 0.11,
              "thickness": 0.005
            }
          }
        ],
        "anchors": {
          "start": {
            "node": "pipe",
            "onGeometry": {
              "type": "feature",
              "name": "start"
            }
          },
          "end": {
            "node": "pipe",
            "onGeometry": {
              "type": "feature",
              "name": "end"
            }
          }
        }
      }
    }
  }
}
