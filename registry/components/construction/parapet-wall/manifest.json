{
  "schemaVersion": "0.1",
  "id": "construction.parapet-wall",
  "version": "0.1.0",
  "kind": "component",
  "title": "直线女儿墙",
  "summary": "带两端拼接锚点和顶部压顶定位点的直线墙段，墙高和厚度可调。",
  "license": "Apache-2.0",
  "semanticType": "construction.roof.parapet",
  "capabilities": [
    "resize",
    "attach",
    "material"
  ],
  "tags": [
    "建筑",
    "屋面",
    "女儿墙",
    "外立面",
    "基础构件"
  ],
  "parameters": {
    "wallWidth": {
      "type": "number",
      "unit": "m",
      "default": 2.4
    },
    "wallHeight": {
      "type": "number",
      "unit": "m",
      "default": 0.62
    },
    "thickness": {
      "type": "number",
      "unit": "m",
      "default": 0.17
    }
