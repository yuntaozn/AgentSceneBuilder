            },
            "geometry": {
              "type": "partition-wall",
              "wallWidth": 2.4,
              "wallHeight": 0.62,
              "thickness": 0.17
            }
          }
        ],
        "anchors": {
          "wall-left": {
            "node": "parapet",
            "onGeometry": {
              "type": "feature",
              "name": "wall-left"
            }
          },
          "wall-right": {
            "node": "parapet",
            "onGeometry": {
              "type": "feature",
              "name": "wall-right"
            }
          },
          "panel-top": {
            "node": "parapet",
            "onGeometry": {
              "type": "feature",
              "name": "panel-top"
            }
          }
        }
