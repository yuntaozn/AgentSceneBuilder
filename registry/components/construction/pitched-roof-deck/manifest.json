            "onGeometry": {
              "type": "feature",
              "name": "ridge"
            }
          },
          "left": {
            "node": "panel",
            "onGeometry": {
              "type": "feature",
              "name": "left"
            }
          },
          "right": {
            "node": "panel",
            "onGeometry": {
              "type": "feature",
              "name": "right"
            }
          },
          "surface-center": {
            "node": "panel",
            "onGeometry": {
              "type": "feature",
              "name": "surface-center"
            }
          },
          "underside-center": {
            "node": "panel",
            "onGeometry": {
              "type": "feature",
              "name": "underside-center"
            }
          }
