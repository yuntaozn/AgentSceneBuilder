  "kind": "component",
  "title": "爬模移轨与可翻锁舌附墙座",
  "summary": "竖向孔轨、可转止退锁舌、导向滚轮及固定贴墙底座，轨和锁舌各有姿态。",
  "license": "Apache-2.0",
  "semanticType": "construction.sliding-climbing-formwork-rail-and-locking-wall-shoe",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "爬模导轨",
    "附墙锁舌",
    "climbing-formwork",
    "rail-shoe",
    "模板工装",
    "formwork"
  ],
  "anchors": [
    "wall",
    "rail-top",
    "rail-bottom",
    "lock-tip"
  ],
  "ai": {
    "intent": "将可升孔轨和附墙锁座放入爬模系统表达装配及解锁空间，可读取轨端与附墙座的独立锚点。",
    "editableParts": [
      "rail-lift",
      "lock-release"
    ],
    "qualityChecks": [
      "重复矩形槽为贯通孔。",
      "锁舌转动和导轨升程可分别设置。",
      "固定座不随轨升降。"
    ]
  },
