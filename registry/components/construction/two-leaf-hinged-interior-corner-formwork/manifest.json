    "hinge"
  ],
  "ai": {
    "intent": "可组合成不同内角的模板边缘模块，Agent 可取两块面板的安装与接触面坐标。",
    "editableParts": [
      "included-angle"
    ],
    "qualityChecks": [
      "两片共享一根铰轴、边孔保留实际穿孔。",
      "调整内角只作用于第二片。",
      "固定片和固定铰轴不跟动。"
    ]
  },
