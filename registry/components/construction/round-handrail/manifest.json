{
  "schemaVersion": "0.1",
  "id": "construction.round-handrail",
  "version": "0.1.0",
  "kind": "component",
  "title": "圆管直扶手",
  "summary": "沿局部 +X 延伸的空心圆扶手，长度、外径和壁厚可编辑。",
  "license": "Apache-2.0",
  "semanticType": "construction.railing.handrail",
  "capabilities": [
    "resize",
    "attach",
    "material"
  ],
  "tags": [
    "建筑",
    "基础构件",
    "扶手",
    "栏杆"
  ],
  "parameters": {
    "length": {
      "type": "number",
      "unit": "m",
      "default": 1.5
    },
    "outerDiameter": {
      "type": "number",
      "unit": "m",
      "default": 0.044
    },
    "thickness": {
      "type": "number",
      "unit": "m",
      "default": 0.003
    }
  },
  "anchors": [
    "start",
    "end"
  ],
  "editor": {
    "document": {
      "id": "round-handrail",
      "component": "core.composition",
      "parameters": {
        "nodes": [
          {
            "id": "rail",
            "semanticType": "construction.railing.handrail",
            "material": "steel",
            "appearance": {
              "color": "#82909a"
            },
            "geometry": {
              "type": "steel-round-tube",
              "length": 1.5,
              "outerDiameter": 0.044,
              "thickness": 0.003
            }
          }
        ],
        "anchors": {
          "start": {
            "node": "rail",
            "onGeometry": {
              "type": "feature",
              "name": "start"
            }
          },
          "end": {
            "node": "rail",
            "onGeometry": {
              "type": "feature",
              "name": "end"
            }
          }
        }
      }
    }
  }
}
