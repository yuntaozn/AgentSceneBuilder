{
  "schemaVersion": "0.1",
  "id": "construction.top-track-industrial-sliding-door-module",
  "version": "0.1.0",
  "kind": "component",
  "title": "顶轨式工业平移门组件",
  "summary": "开式挂轨、双滚轮吊架、可移动门扇、地下导向件和框边行程止挡。",
  "license": "Apache-2.0",
  "semanticType": "construction.top-track-industrial-sliding-door-module",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "工业平移门",
    "吊轨门",
    "sliding-door",
    "top-track",
    "建筑构件",
    "building"
  ],
  "anchors": [
    "track-fixing",
    "panel-leading-edge",
    "door-pull",
    "finished-floor"
  ],
  "ai": {
    "intent": "为仓储、机房或工业隔断表达可沿固定顶轨平移的独立门组件。",
    "editableParts": [
      "slide-distance"
    ],
    "qualityChecks": [
      "两个吊架及门扇同步移动。",
      "开式挂轨和地面定位导向保持固定。",
      "门把与门前缘跟随门扇。"
    ]
  },
