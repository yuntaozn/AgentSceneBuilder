{
  "schemaVersion": "0.1",
  "id": "construction.entrance-canopy",
  "version": "0.1.0",
  "kind": "component",
  "title": "单坡入口雨棚板",
  "summary": "沿局部 +Z 外挑并向外找坡的雨棚板，提供墙端和前沿锚点。",
  "license": "Apache-2.0",
  "semanticType": "construction.facade.canopy",
  "capabilities": [
    "resize",
    "attach",
    "material"
  ],
  "tags": [
    "建筑",
    "雨棚",
    "入口",
    "外立面",
    "基础构件"
  ],
  "parameters": {
    "coverWidth": {
      "type": "number",
      "unit": "m",
      "default": 1.8
    },
    "projection": {
      "type": "number",
      "unit": "m",
      "default": 0.92
    },
    "thickness": {
      "type": "number",
      "unit": "m",
      "default": 0.065
    },
    "fall": {
      "type": "number",
      "unit": "m",
      "default": 0.065
    }
  },
  "anchors": [
    "mount",
    "front"
  ],
  "editor": {
    "document": {
      "id": "entrance-canopy",
      "component": "core.composition",
      "parameters": {
        "nodes": [
          {
            "id": "canopy",
            "semanticType": "construction.facade.canopy",
            "material": "coated-steel",
            "appearance": {
              "color": "#8499a1"
            },
            "geometry": {
              "type": "sloped-cover",
              "coverWidth": 1.8,
              "projection": 0.92,
              "thickness": 0.065,
              "fall": 0.065
            }
          }
        ],
        "anchors": {
          "mount": {
            "node": "canopy",
            "onGeometry": {
              "type": "feature",
              "name": "mount"
            }
          },
          "front": {
            "node": "canopy",
            "onGeometry": {
              "type": "feature",
              "name": "front"
            }
          }
        }
      }
    }
  }
}
