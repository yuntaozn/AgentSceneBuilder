{
  "schemaVersion": "0.1",
  "id": "construction.rack-drive-sliding-gate-operator",
  "version": "0.1.0",
  "kind": "component",
  "title": "带齿条的平移门机驱动模块",
  "summary": "带安装座、电机减速箱、防护上盖、外露齿轮、齿条导轨和电控接口的门机驱动单体。",
  "license": "Apache-2.0",
  "semanticType": "construction.rack-drive-sliding-gate-operator",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "平移门机",
    "门机驱动",
    "sliding-gate-operator",
    "rack-drive",
    "建筑构件",
    "building"
  ],
  "anchors": [
    "rack-attachment",
    "operator-fixing",
    "drive-axis"
  ],
  "ai": {
    "intent": "为建筑自动平移门提供可单独安装的齿轮齿条传动，门扇可在外部配接。",
    "editableParts": [
      "rack-travel",
      "service-cover"
    ],
    "qualityChecks": [
      "齿条平移时，驱动齿轮沿固定轴旋转。",
      "齿条安装耳随齿条移动。",
      "底座和维修罩围绕独立基准。"
    ]
  },
