  "title": "壁装升降挂钩式车辆约束器",
  "summary": "带垂直导轨、独立滑座、倒钩、上下限位与开孔安装板，方便单独表达挂接和避让包络。",
  "license": "Apache-2.0",
  "semanticType": "equipment.wall-track-lifting-hook-trailer-restraint",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "装卸口约束器",
    "挂钩约束",
    "trailer-restraint",
    "vertical-carriage",
    "装卸设备",
    "loading-dock"
  ],
  "anchors": [
    "wall",
    "hook-throat",
    "bar-approach"
  ],
  "ai": {
    "intent": "将墙面安装车辆约束器作为独立单体调用，引用实际挂钩喉口及导轨行程建立接触位置。",
    "editableParts": [
      "carriage-rise",
      "hook-angle"
    ],
    "qualityChecks": [
      "安装孔贯通。",
      "挂钩可旋转，滑座可沿固定导轨移动。",
      "挂钩锚点随两种姿态变化。"
    ]
  },
