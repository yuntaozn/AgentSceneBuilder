{
  "schemaVersion": "0.1",
  "id": "equipment.powered-adjustable-pipe-rotator-module",
  "version": "0.1.0",
  "kind": "component",
  "title": "可调距动力滚轮架",
  "summary": "左右滚轮座、共用安装底板、可调间距、驱动电机和两轴径向接触点。",
  "license": "Apache-2.0",
  "semanticType": "equipment.powered-adjustable-pipe-rotator-module",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "管道滚轮架",
    "滚轮焊接架",
    "pipe-rotator",
    "tank-roller",
    "机械基础件",
    "equipment"
  ],
  "anchors": [
    "rolling-contact--1",
    "rolling-contact-1",
    "base",
    "work-axis"
  ],
  "ai": {
    "intent": "为独立管道、长罐或卷筒翻转装置提供可调滚轮支承，便于组合双机架。",
    "editableParts": [
      "roller-spacing",
      "traction-angle"
    ],
    "qualityChecks": [
      "两组滚轮按同样行程对称移位。",
      "驱动端随载座移动，底架仍固定。",
      "轴线与工件参考坐标同向。"
    ]
  },
