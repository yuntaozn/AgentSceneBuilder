      "front-angle",
      "rear-angle",
      "shaft-reach",
      "shaft-turn"
    ],
    "qualityChecks": [
      "两节护罩保留嵌套空腔。",
      "万向叉耳有独立通孔。",
      "输出基准可随长度或末端姿态改变。"
    ]
  },
