    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "拖拉机动力输出轴",
    "伸缩农机传动轴",
    "guarded-pto-shaft",
    "telescopic-cardan-drive",
    "通用农机装配",
    "agricultural-machinery"
  ],
  "anchors": [
    "implement-output",
    "tractor-input"
  ],
  "ai": {
    "intent": "将独立式伸缩轴置于动力输出口与挂具之间，输入固定参考，输出随轴长和折角变位。",
