{
  "schemaVersion": "0.1",
  "id": "equipment.telescopic-trench-shield-pinned-spreader",
  "version": "0.1.0",
  "kind": "component",
  "title": "沟槽箱伸缩式销接撑杆",
  "summary": "有内外套管、真实定位孔、两端销接耳、抽插销及可编辑伸缩量，适配箱式支护独立侧板。",
  "license": "Apache-2.0",
  "semanticType": "equipment.telescopic-trench-shield-pinned-spreader",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "沟槽支护撑杆",
    "销接伸缩",
    "shield-spreader",
    "telescopic-tube",
    "沟槽施工",
    "excavation"
  ],
  "anchors": [
    "fixed-clevis",
    "moving-clevis",
    "pin-grip"
  ],
  "ai": {
    "intent": "以两端销接锚点跨接面对面的沟槽箱侧板，调整伸缩量后重新定位活动侧板。",
    "editableParts": [
      "spreader-travel",
      "pin-withdrawal"
    ],
    "qualityChecks": [
      "伸缩移动端保有与固定套管重叠的导向段。",
      "两端销接轴保持同轴，固定销孔锚点不随伸缩变化。",
      "抽销后可连续预览行程，只有相距 0.08 米的孔位能重新插销。"
    ]
  },
