{
  "schemaVersion": "0.1",
  "id": "equipment.bearing-idler-chain-tensioner",
  "version": "0.1.0",
  "kind": "component",
  "title": "弹簧加载滚子链张紧器",
  "summary": "带安装孔的底座、摆臂、转动链轮、手动预紧杆与限位块，提供链轮切线锚点。",
  "license": "Apache-2.0",
  "semanticType": "equipment.bearing-idler-chain-tensioner",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "链条张紧器",
    "张紧轮",
    "chain-tensioner",
    "idler-sprocket",
    "机械基础件",
    "machine-element"
  ],
  "anchors": [
    "mount",
    "arm-pivot",
    "chain-tangent"
  ],
  "ai": {
    "intent": "为开式链传动装配提供弹簧张紧与可读取的链条过渡点。",
    "editableParts": [
      "arm-angle",
      "idler-angle"
    ],
    "qualityChecks": [
      "张紧摆臂绕固定支架转轴。",
      "轮齿随链轮回转，链条参考则留在轮轴架。",
      "安装底座有贯通孔。"
    ]
  },
