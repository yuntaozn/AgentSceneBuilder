  "kind": "component",
  "title": "十字轴万向联轴节",
  "summary": "两件错开 90 度的叉头、一体十字轴、四轴承杯与两个端孔。可分别调整十字轴和从动叉头角度。",
  "license": "Apache-2.0",
  "semanticType": "equipment.cross-spider-universal-joint",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "万向节",
    "十字轴",
    "universal-joint",
    "cardan",
    "机械基础件",
    "machine-element"
  ],
  "anchors": [
    "drive-shaft",
    "load-shaft",
    "joint-center"
  ],
  "ai": {
    "intent": "用于构建非直线轴系，可读取叉头连接和两方向的弯折关节。",
    "editableParts": [
      "first-pivot",
      "second-pivot"
    ],
    "qualityChecks": [
      "两个折角共享十字轴中心。",
      "从动轴随两个关节调整。",
      "主动端保持固定，两个轴端保留开口。"
    ]
  },
