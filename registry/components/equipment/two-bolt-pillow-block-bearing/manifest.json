    "right-base-hole",
    "grease-port"
  ],
  "ai": {
    "intent": "在轴系中提供带底部安装接口的可调轴承座，允许沿轴孔装配驱动轴。",
    "editableParts": [
      "shaft-angle"
    ],
    "qualityChecks": [
      "中心轴孔贯通，轴孔两端保持对齐。",
      "内圈与紧定环同步旋转。",
      "上、下壳与安装底座保持固定。"
    ]
  },
