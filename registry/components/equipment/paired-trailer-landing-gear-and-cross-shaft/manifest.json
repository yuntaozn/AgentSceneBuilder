    "right-frame",
    "right-pad",
    "operator-grip"
  ],
  "ai": {
    "intent": "安装在拖车底架，表现两条支腿同步伸缩、摇柄摆位和落脚基准。搭接用两块安装板。",
    "editableParts": [
      "leg-extension",
      "foot-tilt",
      "crank-turn"
    ],
    "qualityChecks": [
      "脚盘可摆动，脚盘左右与支腿行程同步。",
      "伸缩最大时内外方管仍重叠。",
      "车架挂点不随脚盘和摇柄移动。"
    ]
  },
