{
  "schemaVersion": "0.1",
  "id": "instrument.digital-caliper-with-depth-blade",
  "version": "0.1.0",
  "kind": "component",
  "title": "带内外测爪及深度尺的数显卡尺",
  "summary": "实尺梁、防脱导槽、带显示器活动尺框、外测与内测两组测爪，以及随尺框抽出的深度尺。",
  "license": "Apache-2.0",
  "semanticType": "instrument.digital-caliper-with-depth-blade",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "数显卡尺",
    "游标卡尺",
    "digital-caliper",
    "depth-measurement",
    "计量",
    "instrument"
  ],
  "anchors": [
    "outside-fixed",
    "outside-moving",
    "inside-fixed",
    "inside-moving",
    "depth-tip",
    "depth-base"
  ],
  "ai": {
    "intent": "为 Agent 提供独立量具模型和三类测量接口，按尺框行程表达开合。",
    "editableParts": [
      "caliper-travel"
    ],
    "qualityChecks": [
      "外测和内测动尺爪随尺框移动。",
      "深度接触点跟随尺框，深度基准留在尺梁。",
      "动尺框通过榫槽套在主尺上。"
    ]
  },
