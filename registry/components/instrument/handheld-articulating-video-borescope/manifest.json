{
  "schemaVersion": "0.1",
  "id": "instrument.handheld-articulating-video-borescope",
  "version": "0.1.0",
  "kind": "component",
  "title": "可转向工业视频内窥镜",
  "summary": "手持显示单元、万向蛇管、双方向可调探头、前视镜头和六个环绕补光窗口。",
  "license": "Apache-2.0",
  "semanticType": "instrument.handheld-articulating-video-borescope",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "工业内窥镜",
    "视频内窥镜",
    "video-borescope",
    "inspection-probe",
    "测量",
    "instrument"
  ],
  "anchors": [
    "display-view",
    "probe-seat",
    "camera-axis"
  ],
  "ai": {
    "intent": "用于机壳、管道或隐蔽空间检测的独立小型视频内窥镜。",
    "editableParts": [
      "probe-bend",
      "probe-yaw"
    ],
    "qualityChecks": [
      "镜头和补光窗随探头朝向改变。",
      "显示器和蛇管起点保持固定。",
      "可通过外露锚点定位探头视线。"
    ]
  },
