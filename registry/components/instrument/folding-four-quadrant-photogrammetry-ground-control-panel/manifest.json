  "version": "0.1.0",
  "kind": "component",
  "title": "四象限折叠航测地面控制板",
  "summary": "四象限高对比靶面、贯通中心对中孔和两片可折板，中心基准保留到独立下支架。",
  "license": "Apache-2.0",
  "semanticType": "instrument.folding-four-quadrant-photogrammetry-ground-control-panel",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "航测地面像控点",
    "摄影测量靶板",
    "ground control point target",
    "foldable quadrant panel",
    "摄影测量模型",
    "photogrammetry hardware"
  ],
  "anchors": [
    "mark-center",
    "tripod-seat"
  ],
  "ai": {
    "intent": "作为布置点位的独立摄影测量地面标靶，可读取中心锚点，分别设置左右面板折角。",
    "editableParts": [
      "left-fold",
      "right-fold"
    ],
    "qualityChecks": [
      "靶面维持黑白对角分区。",
      "中心计量点不受面板折角影响。"
    ]
  },
