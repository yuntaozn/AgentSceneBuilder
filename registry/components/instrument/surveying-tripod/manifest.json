  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "测量",
    "测绘",
    "survey",
    "site-instrument",
    "三脚架",
    "tripod",
    "telescoping-leg"
  ],
  "anchors": [
    "ground-contact-1",
    "ground-contact-2",
    "ground-contact-3",
    "instrument-mount",
    "plummet-axis"
  ],
  "ai": {
    "intent": "在测绘仪器装配中提供三腿支撑、独立调平和基座装夹。",
    "useWhen": [
      "需要支承全站仪、自动安平水准仪或旋转激光仪时。"
    ],
    "editableParts": [
      "spread-leg-1",
      "extend-leg-1",
      "spread-leg-2",
      "extend-leg-2",
      "spread-leg-3",
      "extend-leg-3"
    ],
    "qualityChecks": [
      "三只脚尖随各自支腿运动。",
      "中心准线持续通过安装座贯通孔。"
    ]
  },
