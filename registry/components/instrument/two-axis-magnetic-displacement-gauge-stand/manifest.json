    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "位移表磁座",
    "试验位移测点",
    "displacement-gauge-stand",
    "fine-adjustment",
    "结构试验",
    "structural-testing"
  ],
  "anchors": [
    "base",
    "touch",
    "dial"
  ],
  "ai": {
    "intent": "独立于被测结构设置位移表固定架，编辑表体姿态及测头相对被测面的位置。",
