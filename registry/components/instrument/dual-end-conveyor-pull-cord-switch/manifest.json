{
  "schemaVersion": "0.1",
  "id": "instrument.dual-end-conveyor-pull-cord-switch",
  "version": "0.1.0",
  "kind": "component",
  "title": "双端拉绳急停开关",
  "summary": "带贯通安装座、双端拉环、可摆触发杠杆、复位按钮和带实孔接线格兰的输送线开关。",
  "license": "Apache-2.0",
  "semanticType": "instrument.dual-end-conveyor-pull-cord-switch",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "拉绳开关",
    "急停开关",
    "pull-cord-switch",
    "conveyor",
    "工业检测",
    "instrument"
  ],
  "anchors": [
    "cord-left",
    "cord-right",
    "base",
    "signal"
  ],
  "ai": {
    "intent": "在输送设备装配中复用双向拉绳开关，可读取拉绳连接点和信号接口。",
    "editableParts": [
      "trip-angle"
    ],
    "qualityChecks": [
      "两个拉环随触发杠杆转动。",
      "底座和输出接线端保持固定。",
      "拉环与安装孔均有可见内腔。"
    ]
  },
