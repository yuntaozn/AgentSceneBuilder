  "version": "0.1.0",
  "kind": "component",
  "title": "双轴地面三维扫描仪",
  "summary": "独立架站座、水平回转台、俯仰反射窗、转镜轴和可编辑出射参考的三维扫描测绘单体。",
  "license": "Apache-2.0",
  "semanticType": "instrument.dual-axis-terrestrial-laser-scanner",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "三维扫描仪",
    "地面激光扫描",
    "terrestrial-laser-scanner",
    "survey-lidar",
    "测量",
    "instrument"
  ],
  "anchors": [
    "tripod-mount",
    "scan-origin",
    "head-axis",
    "azimuth-axis"
  ],
  "ai": {
    "intent": "作为地面测绘设备复用，提供三脚架座和随两轴转动的扫描光线。",
    "editableParts": [
      "azimuth",
      "scan-elevation"
    ],
    "qualityChecks": [
      "出射基准与反射窗保持同一头部坐标系。",
      "固定安装座位于水平轴中心。",
      "水平和俯仰分别可编辑。"
    ]
  },
