{
  "schemaVersion": "0.1",
  "id": "instrument.pole-mounted-ptz-construction-inspection-camera",
  "version": "0.1.0",
  "kind": "component",
  "title": "立杆式双轴工地巡检摄像头",
  "summary": "开孔立杆抱箍底座、悬臂、水平回转座、俯仰机芯、补光窗、镜头罩和独立线缆端。",
  "license": "Apache-2.0",
  "semanticType": "instrument.pole-mounted-ptz-construction-inspection-camera",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "工地摄像头",
    "云台摄像机",
    "ptz-camera",
    "pole-mounted",
    "工程检测",
    "instrument"
  ],
  "anchors": [
    "pole-axis",
    "lens-axis",
    "power-data"
  ],
  "ai": {
    "intent": "在智慧工地或设施巡检数字模型中独立布置立杆摄像机，读取镜头与安装基准。",
    "editableParts": [
      "pan-angle",
      "tilt-angle"
    ],
    "qualityChecks": [
      "两处抱箍各有实际空腔。",
      "镜头、补光窗和雨罩随俯仰部件。",
      "接线端留在固定支架。"
    ]
  },
