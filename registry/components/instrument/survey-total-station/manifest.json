{
  "schemaVersion": "0.1",
  "id": "instrument.survey-total-station",
  "version": "0.1.0",
  "kind": "component",
  "title": "工程测量全站仪",
  "summary": "独立水平和竖直回转轴、带提手双臂架、面板、调平底座和双端镜筒组成的全站仪单体。",
  "license": "Apache-2.0",
  "semanticType": "instrument.survey-total-station",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "测量",
    "测绘",
    "survey",
    "site-instrument",
    "全站仪",
    "total-station",
    "azimuth",
    "elevation"
  ],
  "anchors": [
    "sight-origin",
    "sight-axis",
    "tripod-mount",
    "plummet-axis",
    "elevation-axis"
  ],
  "ai": {
    "intent": "作为独立测量设备参与工程测绘场景并控制水平方向与俯仰角。",
    "editableParts": [
      "azimuth-angle",
      "elevation-angle"
    ],
    "qualityChecks": [
      "水平回转只带动基座以上的活动机身。",
      "俯仰以两侧耳轴为中心，光轴跟随镜筒。",
      "底部安装点保持固定。"
    ]
  },
