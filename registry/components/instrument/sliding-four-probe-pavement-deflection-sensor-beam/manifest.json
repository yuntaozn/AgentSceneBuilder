  "ai": {
    "intent": "单独布置路面位移测点梁，或与落锤头通过对向端面连接。可把四个输出锚点作为数字检测参考。",
    "editableParts": [
      "probe-pitch-offset",
      "probe-retract"
    ],
    "qualityChecks": [
      "间距控制移动三个滑座，首个基准探头固定。",
      "测点锚点处于相同基准高度。",
      "配接锚点不随测头和间距变化。"
    ]
  },
