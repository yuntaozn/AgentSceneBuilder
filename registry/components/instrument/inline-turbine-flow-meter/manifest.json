    "pipe-out",
    "pulse-out",
    "meter-axis"
  ],
  "ai": {
    "intent": "以独立流量计连接直管段，支持标注流向、脉冲端与可动涡轮。",
    "editableParts": [
      "turbine-angle"
    ],
    "qualityChecks": [
      "管道两法兰和转轴同心。",
      "涡轮可在固定整流支撑之间转动。",
      "流管具有开口截面，接线端与管体独立。"
    ]
  },
