{
  "schemaVersion": "0.1",
  "id": "tool.hand-crank-branch-pipe-tapping-rig",
  "version": "0.1.0",
  "kind": "component",
  "title": "手摇支管开孔机",
  "summary": "适配独立开孔鞍座，分开表达接口、手轮、空心导向筒、进给杆及带中心导钻的环形刀具。",
  "license": "Apache-2.0",
  "semanticType": "tool.hand-crank-branch-pipe-tapping-rig",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "管道开孔",
    "支管开孔机",
    "branch-tapping-machine",
    "hand-crank",
    "管道工装",
    "pipe-tool"
  ],
  "anchors": [
    "branch-mount",
    "cutter-axis",
    "hand-grip"
  ],
  "ai": {
    "intent": "单独复用支管开孔机或配接既有开孔鞍座，引用固定接口和运动刀轴检查位置。",
    "editableParts": [
      "tool-feed",
      "spindle-angle"
    ],
    "qualityChecks": [
      "光滑导向孔和环形刀具是实际空心。",
      "刀轴沿安装轴移动，旋转中轴心不偏移。",
      "手轮和刀具随同一刀轴动作。"
    ]
  },
