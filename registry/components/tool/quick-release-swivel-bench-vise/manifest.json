  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "台虎钳",
    "快速夹持",
    "bench-vise",
    "workholding",
    "施工工具",
    "tool"
  ],
  "anchors": [
    "anvil-surface",
    "fixed-jaw",
    "moving-jaw",
    "mount-base"
  ],
  "ai": {
    "intent": "用作台面工装，定位安装底盘、固定和活动钳面、砧台。",
    "editableParts": [
      "jaw-travel",
      "body-turn",
      "handwheel-angle",
      "handle-slide"
    ],
    "qualityChecks": [
      "活动导轨在全行程内与固定套保持搭接。",
      "两个钳面沿同一轴线对夹。",
      "钳体回转不改变四孔安装底盘。"
    ]
  },
