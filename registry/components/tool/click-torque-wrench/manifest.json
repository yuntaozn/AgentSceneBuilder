  "capabilities": [
    "attach",
    "inspect-structure"
  ],
  "tags": [
    "施工工具",
    "紧固",
    "手工具",
    "扳手",
    "扭矩扳手",
    "torque wrench",
    "套筒"
  ],
  "anchors": [
    "grip",
    "drive"
  ],
  "ai": {
    "intent": "按 grip 放置手部，按 drive 把同规格套筒接到工作端。",
