  "tags": [
    "套丝头",
    "管螺纹",
    "threading-die",
    "pipe-tool",
    "施工工具",
    "tool"
  ],
  "anchors": [
    "pipe-entry",
    "pipe-exit",
    "grip"
  ],
  "ai": {
    "intent": "使用独立套丝工具表示管材中心线与工作板牙。",
    "editableParts": [
      "die-angle",
      "reverser-angle"
    ],
    "qualityChecks": [
      "中心孔轴线跟随转架且保持与外框同心。",
      "板牙沿四个方向排布。",
      "调换棘轮方向时机架与工作孔保持固定。"
    ]
  },
