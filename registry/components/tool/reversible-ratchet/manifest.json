  "kind": "component",
  "title": "可换套筒棘轮扳手",
  "summary": "带切换拨杆、释放按钮、弯柄和 3/8 英寸方驱的短柄棘轮。",
  "license": "Apache-2.0",
  "semanticType": "tool.reversible-ratchet",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "施工工具",
    "紧固",
    "手工具",
    "棘轮",
    "扳手",
    "套筒",
    "ratchet"
  ],
  "anchors": [
    "grip",
    "drive"
  ],
  "ai": {
    "intent": "将棘轮拨杆视为独立转轴，将 10、13 或 17 mm 套筒接到方驱。",
    "editableParts": [
      "selector-angle"
    ],
    "qualityChecks": [
      "拨杆旋转时方驱和头部位置保持固定。",
      "drive 和对应套筒锚点应同点反向。"
    ]
  },
