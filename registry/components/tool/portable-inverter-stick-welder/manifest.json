  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "逆变焊机",
    "焊机",
    "inverter-welder",
    "welding",
    "施工工具",
    "tool"
  ],
  "anchors": [
    "positive-output",
    "negative-output",
    "grip",
    "ground"
  ],
  "ai": {
    "intent": "独立表达焊接电源的正负极快插端、提携与面板组件。",
    "editableParts": [
      "current-dial",
      "handle-fold"
    ],
    "qualityChecks": [
      "快插端孔通过前面板。",
      "提手旋转不带动固定面板。",
      "两侧散热槽为建模开口。"
    ]
  },
