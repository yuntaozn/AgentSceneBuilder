{
  "schemaVersion": "0.1",
  "id": "tool.portable-inverter-stick-welder",
  "version": "0.1.0",
  "kind": "component",
  "title": "便携逆变焊机主机",
  "summary": "带独立散热侧板、前部控制旋钮、两个有深度的快插端和可折叠提手的逆变焊机。",
