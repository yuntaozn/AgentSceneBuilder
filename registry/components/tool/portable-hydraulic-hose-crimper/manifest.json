{
  "schemaVersion": "0.1",
  "id": "tool.portable-hydraulic-hose-crimper",
  "version": "0.1.0",
  "kind": "component",
  "title": "液压软管扣压机",
  "summary": "带八分瓣扣压模、独立导向压环、手动液压泵、活塞推座和可调底脚。",
  "license": "Apache-2.0",
  "semanticType": "tool.portable-hydraulic-hose-crimper",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "软管扣压",
    "液压压接",
    "hose-crimper",
    "crimping-die",
    "施工工具",
    "tool"
  ],
  "anchors": [
    "hose-center",
    "pump-grip",
    "base"
  ],
  "ai": {
    "intent": "在软管加工或设备维护装配中复用独立扣压设备，读取进料轴线和泵杆位置。",
    "editableParts": [
      "radial-crimp",
      "pump-angle"
    ],
    "qualityChecks": [
      "八个模瓣围绕中心同步收缩。",
      "推动压环沿中心轴移动。",
      "整机保有固定底板和贯通工作口。"
    ]
  },
