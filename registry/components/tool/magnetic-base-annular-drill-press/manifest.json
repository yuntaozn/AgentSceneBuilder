{
  "schemaVersion": "0.1",
  "id": "tool.magnetic-base-annular-drill-press",
  "version": "0.1.0",
  "kind": "component",
  "title": "磁座式空心钻机",
  "summary": "有双极磁靴、燕尾导向、空心刀具、进给手轮和可调齿轮箱滑架的独立制孔工具。",
  "license": "Apache-2.0",
  "semanticType": "tool.magnetic-base-annular-drill-press",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "磁座钻",
    "空心钻",
    "magnetic-drill",
    "steel-fabrication",
    "施工工具",
    "tool"
  ],
  "anchors": [
    "magnetic-plane",
    "cutting-plane",
    "tool-axis"
  ],
  "ai": {
    "intent": "用于钢构件加工与维护的独立磁座钻模型，可定位吸附面、刀具轴和进给控制。",
    "editableParts": [
      "feed-down",
      "cutter-angle"
    ],
    "qualityChecks": [
      "空心刀具随滑架进给。",
      "电机与齿轮箱同时移动。",
      "两个磁靴与工件基准保持固定。"
    ]
  },
