{
  "schemaVersion": "0.1",
  "id": "tool.lever-rotary-draw-tube-bender",
  "version": "0.1.0",
  "kind": "component",
  "title": "手动旋转拉弯弯管器",
  "summary": "带成形轮、开放导槽、走管切向、可摆长柄和可调跟随压辊的手动弯管工具。",
  "license": "Apache-2.0",
  "semanticType": "tool.lever-rotary-draw-tube-bender",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "弯管器",
    "手动折弯",
    "tube-bender",
    "rotary-draw",
    "施工工具",
    "tool"
  ],
  "anchors": [
    "pipe-feed",
    "forming-axis",
    "follower-axis",
    "grip"
  ],
  "ai": {
    "intent": "为管件预制组装提供独立成形工具及进管和夹辊位置。",
    "editableParts": [
      "bend-angle",
      "follower-travel"
    ],
    "qualityChecks": [
      "成形轮与主销固定同轴。",
      "随动辊随长柄摆动，也可独立径向移动。",
      "底座和进管参考保持固定。"
    ]
  },
