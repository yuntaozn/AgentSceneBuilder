    "tool"
  ],
  "anchors": [
    "base",
    "cutting-face",
    "water-inlet",
    "motor-interface"
  ],
  "ai": {
    "intent": "以独立垂直取芯配套设备表达导向进给、空心钻筒和水路接头。",
