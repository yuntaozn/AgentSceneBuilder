      "feed-travel",
      "spindle-angle",
      "feed-wheel-angle"
    ],
    "qualityChecks": [
      "钻筒中心空腔可见。",
      "进给移动同时带动钻筒、齿轮箱和接水点。",
      "底板和立柱保持固定。"
    ]
  },
