  ],
  "tags": [
    "建筑",
    "装配式",
    "基础构件",
    "预制楼板",
    "楼承板",
    "组合楼板",
    "压型钢板"
  ],
  "parameters": {
    "length": {
      "type": "number",
      "unit": "m",
      "default": 2.1
    },
    "ribPitch": {
      "type": "number",
      "unit": "m",
      "default": 0.19
    },
    "crownWidth": {
      "type": "number",
      "unit": "m",
      "default": 0.079
    },
    "troughWidth": {
      "type": "number",
      "unit": "m",
      "default": 0.067
    },
    "ribHeight": {
      "type": "number",
      "unit": "m",
      "default": 0.05
    },
    "thickness": {
      "type": "number",
      "unit": "m",
      "default": 0.002
    },
    "ribCount": {
      "type": "number",
      "default": 4
