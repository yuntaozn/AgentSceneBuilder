{
  "schemaVersion": "0.1",
  "id": "structure.ribbed-composite-deck-sheet",
  "version": "0.1.0",
  "kind": "component",
  "title": "梯形肋压型楼承钢板",
  "summary": "谷底、斜腹和肋顶组成连续薄壁截面，覆盖宽度由肋距和肋数决定。",
  "license": "Apache-2.0",
  "semanticType": "structure.floor.ribbed-composite-deck",
  "capabilities": [
    "resize",
    "attach",
    "inspect-structure",
