  "anchors": [
    "start",
    "end",
    "near-edge",
    "far-edge",
    "crown-first",
    "bearing-start",
    "bearing-end"
  ],
  "ai": {
    "intent": "在可编辑组合楼板中表现波形钢底板和上部支承面。",
    "editableParts": [
      "肋距与肋数",
      "板厚",
      "谷底宽",
      "肋高"
    ],
    "qualityChecks": [
      "截面顶、底轮廓连续且厚度真实。"
    ]
  },
