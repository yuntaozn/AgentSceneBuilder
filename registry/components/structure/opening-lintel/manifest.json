{
  "schemaVersion": "0.1",
  "id": "structure.opening-lintel",
  "version": "0.1.0",
  "kind": "component",
  "title": "矩形洞口过梁",
  "summary": "带洞口居中点和两端底面支承点的矩形过梁。",
  "license": "Apache-2.0",
  "semanticType": "structure.lintel",
  "capabilities": [
    "resize",
    "attach",
    "material"
  ],
  "tags": [
    "建筑",
    "结构",
    "过梁",
    "洞口",
    "基础构件"
  ],
  "parameters": {
    "length": {
      "type": "number",
      "unit": "m",
      "default": 1.5
    },
    "height": {
      "type": "number",
      "unit": "m",
      "default": 0.22
    },
    "depth": {
      "type": "number",
      "unit": "m",
      "default": 0.15
    }
  },
  "anchors": [
    "opening-seat",
    "left-bearing",
    "right-bearing"
  ],
  "ai": {
    "intent": "提供可独立安装、可重复放置的洞口过梁。",
    "editableParts": [
      "lintel.geometry.size 使用 [长度, 高度, 深度]"
    ],
    "qualityChecks": [
      "过梁两端应对应目标墙段的支承位置。"
    ]
  },
  "editor": {
    "document": {
      "id": "opening-lintel",
      "component": "core.composition",
      "parameters": {
        "nodes": [
          {
            "id": "lintel",
            "semanticType": "structure.lintel",
            "material": "concrete",
            "appearance": {
              "color": "#9ba6aa"
            },
            "geometry": {
              "type": "box",
              "size": [1.5,0.22,0.15]
            },
            "transform": {
              "position": [0,0.11,0]
            }
          }
        ],
        "anchors": {
          "opening-seat": {
            "node": "lintel",
            "onGeometry": {
              "type": "box",
              "fraction": [0,-0.5,0]
            }
          },
          "left-bearing": {
            "node": "lintel",
            "onGeometry": {
              "type": "box",
              "fraction": [-0.5,-0.5,0]
            }
          },
          "right-bearing": {
            "node": "lintel",
            "onGeometry": {
              "type": "box",
              "fraction": [0.5,-0.5,0]
            }
          }
        }
      }
    }
  }
}
