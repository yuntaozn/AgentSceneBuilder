        "nodes": [
          {
            "id": "body",
            "semanticType": "structure.bolted-base-plate",
            "material": "steel",
            "appearance": {
              "color": "#91a0a7"
            },
            "geometry": {
              "type": "bolted-base-plate",
              "plateWidth": 0.38,
              "plateDepth": 0.36,
              "thickness": 0.02,
              "holeDiameter": 0.03,
              "boltPitchX": 0.3,
              "boltPitchZ": 0.28
            }
          }
        ],
        "anchors": {
          "mount": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "mount"
            }
          },
          "column-seat": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "column-seat"
            }
          },
          "bolt-front-left": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "bolt-front-left"
            }
          },
          "bolt-front-right": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "bolt-front-right"
            }
          },
          "bolt-back-left": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "bolt-back-left"
            }
          },
          "bolt-back-right": {
            "node": "body",
            "onGeometry": {
              "type": "feature",
              "name": "bolt-back-right"
