  "kind": "composition",
  "title": "桌面显示器",
  "summary": "完全由参数化几何组成的桌面显示器模型，表达屏幕面板、发光显示面、窄边框、背壳、铰链、支架、底座、控制按键、接口和线缆连接点。",
  "license": "Apache-2.0",
  "semanticType": "electronics.display.monitor",
  "capabilities": [
    "inspect-structure",
    "anchors",
    "material",
    "edit-repetition",
    "screen-surface",
    "no-glb"
  ],
  "tags": [
    "电子设备",
    "显示器",
    "桌面外设",
    "屏幕",
    "参数化模型",
    "无GLB"
  ],
  "parameters": {
    "screenSize": {
      "type": "vec2",
      "unit": "m",
      "default": [
        0.528,
        0.297
      ]
    },
    "standHeight": {
      "type": "number",
      "unit": "m",
      "default": 0.1804
    },
    "buttonCount": {
      "type": "integer",
      "default": 5
    }
  },
