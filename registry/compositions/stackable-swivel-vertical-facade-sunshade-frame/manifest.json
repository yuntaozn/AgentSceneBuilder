  "ai": {
    "intent": "可独立布置在建筑围护面外侧。先把翼片旋至近竖轴边向，再沿轨叠收。",
    "editableParts": [
      "gather",
      "fin-angle"
    ],
    "qualityChecks": [
      "各翼共享行轨但各自保留节点和正面锚点。",
      "转向与叠收可分开设置。",
      "安装边框在任何姿态均固定。"
    ]
  },
