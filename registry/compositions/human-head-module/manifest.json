{
  "schemaVersion": "0.1",
  "id": "character.human-head-module",
  "version": "0.1.0",
  "kind": "composition",
  "title": "人体头部子构件",
  "summary": "由参数化几何生成的可编辑人体头部模块，包含头部轮廓、鼻梁、脸颊、眼睛、眼镜、安全帽、颈部与视线锚点，可作为完整数字人或工人角色的头部子构件复用。",
  "license": "Apache-2.0",
  "semanticType": "character.human.part.head",
  "capabilities": [
    "inspect-structure",
    "anchors",
    "human-part",
    "human-head-module",
    "facial-feature-lofting",
    "section-loft-head",
    "helmet",
    "glasses",
    "no-glb"
  ],
  "tags": [
    "人物",
    "头部",
    "脸部",
    "安全帽",
    "参数化模型",
    "无GLB"
  ],
  "parameters": {
    "height": {
      "type": "number",
      "unit": "m",
      "default": 1.74
    },
    "part": {
      "type": "enum",
      "values": [
        "head"
      ],
      "default": "head"
    }
  },
  "dependencies": [
    "character.human-surface-lowpoly@0.1.0",
    "primitive.sphere@0.1.0",
    "primitive.box@0.1.0",
    "primitive.torus@0.1.0"
  ],
  "ai": {
    "intent": "给 Agent 一个可单独复用的人体头部数字构件，避免每次用球体、锥体和盒子临时堆出玩偶感头部。",
    "useWhen": [
      "需要给工人、讲师、司机、操作员等人形角色添加可编辑头部时使用。",
      "需要测试或改进脸部、头盔、眼镜、视线锚点等头部细节时使用。"
    ],
    "avoidWhen": [
      "需要真实人脸扫描、表情绑定、毛发系统或影视级角色资产时不要把它当最终美术模型。"
    ],
    "editableParts": [
      "head-root",
      "neck",
      "head-pivot",
      "head",
      "nose",
      "left-cheek-facet",
      "right-cheek-facet",
      "left-eye",
      "right-eye",
      "glasses",
      "safety-helmet"
    ],
    "qualityChecks": [
      "鼻子和脸颊应是贴合头部的低浮雕构件，不应像独立玩具零件漂在外面。",
      "安全帽应作为头部外层装备，不应遮挡眼睛和视线锚点。"
    ],
    "commonVariants": [
      "安全帽工人头部",
      "普通人头部",
      "佩戴眼镜的讲师或工程师头部"
    ]
  },
  "visibility": "internal",
