  ],
  "anchors": [
    "carriage-fit",
    "sheet-edge",
    "tine-entry"
  ],
  "ai": {
    "intent": "独立演示滑托板前缘夹紧和直线推送，搭配同类型货叉属具载架。",
    "editableParts": [
      "push-distance",
      "jaw-lift"
    ],
    "qualityChecks": [
      "薄铲板保持固定。",
      "推面伸出时上下夹唇同时跟随推面，上唇仍可独立升降。"
    ]
  },
