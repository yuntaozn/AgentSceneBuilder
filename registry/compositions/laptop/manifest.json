          { "id": "usb-c-port-left", "parent": "laptop", "semanticType": "electronics.laptop.port.usb-c", "geometry": { "type": "box", "size": [0.012, 0.005, 0.008] }, "transform": { "position": [-0.183, 0.011, -0.04] }, "appearance": { "color": "#0a0c0e", "opacity": 1 } },
