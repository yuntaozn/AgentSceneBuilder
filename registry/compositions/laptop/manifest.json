          { "id": "base-body", "parent": "laptop", "semanticType": "electronics.laptop.base-body", "geometry": { "type": "box", "size": [0.36, 0.022, 0.25] }, "transform": { "position": [0, 0.011, 0] }, "appearance": { "color": "#2a2d33", "opacity": 1, "metalness": 0.55, "roughness": 0.35 } },
          { "id": "base-top-plate", "parent": "laptop", "semanticType": "electronics.laptop.base-top-plate", "geometry": { "type": "box", "size": [0.34, 0.003, 0.235] }, "transform": { "position": [0, 0.0235, 0] }, "appearance": { "color": "#1e2126", "opacity": 1, "metalness": 0.4 } },
          { "id": "keyboard-key", "parent": "laptop", "semanticType": "electronics.laptop.keyboard.key", "geometry": { "type": "box", "size": [0.016, 0.003, 0.016] }, "repetition": { "type": "grid", "count": [14, 5, 1], "start": [-0.126, 0.0265, -0.055], "stepX": [0.019, 0, 0], "stepY": [0, 0, 0], "stepZ": [0, 0, 0.019] }, "appearance": { "color": "#0d0f12", "opacity": 1, "metalness": 0.2 } },
          { "id": "spacebar", "parent": "laptop", "semanticType": "electronics.laptop.keyboard.spacebar", "geometry": { "type": "box", "size": [0.085, 0.003, 0.016] }, "transform": { "position": [0, 0.0265, 0.04] }, "appearance": { "color": "#0d0f12", "opacity": 1, "metalness": 0.2 } },
          { "id": "trackpad", "parent": "laptop", "semanticType": "electronics.laptop.trackpad", "geometry": { "type": "box", "size": [0.10, 0.002, 0.065] }, "transform": { "position": [0, 0.025, 0.075] }, "appearance": { "color": "#3a3e45", "opacity": 1, "metalness": 0.3, "roughness": 0.5 } },
          { "id": "hinge-barrel", "parent": "laptop", "semanticType": "electronics.laptop.hinge", "geometry": { "type": "cylinder", "radius": 0.008, "height": 0.32, "radialSegments": 16 }, "transform": { "position": [0, 0.022, -0.125], "rotation": [0, 0, 1.5708] }, "appearance": { "color": "#4a4e55", "opacity": 1, "metalness": 0.7 } },
