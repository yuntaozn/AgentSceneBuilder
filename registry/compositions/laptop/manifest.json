          { "id": "screen-bezel", "parent": "laptop", "semanticType": "electronics.laptop.screen-bezel", "geometry": { "type": "box", "size": [0.34, 0.225, 0.003] }, "transform": { "position": [0, 0.145, -0.139], "rotation": [-0.12, 0, 0] }, "appearance": { "color": "#0a0c0e", "opacity": 1 } },
