{
  "schemaVersion": "0.1",
  "id": "electronics.laptop",
  "version": "0.1.0",
  "kind": "composition",
  "title": "笔记本电脑",
  "summary": "完全由参数化几何组成的笔记本电脑模型，表达机身底座、键盘区域、触控板、显示屏、屏幕边框、摄像头、转轴、接口、散热栅格和底部脚垫。",
  "license": "Apache-2.0",
  "semanticType": "electronics.computer.laptop",
  "capabilities": ["inspect-structure", "anchors", "edit-repetition", "animate", "material", "no-glb"],
  "tags": ["电子设备", "笔记本", "电脑", "便携", "参数化模型", "无GLB"],
  "ai": {
    "intent": "提供一个完全由参数化几何组成的笔记本电脑结构参考，重点表达机身、键盘、触控板、转轴、屏幕、接口和散热等可编辑部件，而不是依赖外部模型文件。",
    "useWhen": [
      "需要在办公、教学、数字设备或人机交互场景中快速放置可解释的笔记本电脑对象。",
      "需要参考如何用基础几何、grid repetition 和少量局部细节表达便携电脑。",
      "需要模型可被 agent 继续拆分、替换接口、调整屏幕角度或修改键盘密度。"
    ],
    "avoidWhen": [
      "需要特定品牌笔记本、真实倒角工艺、超薄曲面外壳或产品级高拟真渲染。",
      "需要精确键帽文字、主板内部结构或真实接口开孔制造细节。"
    ],
    "editableParts": [
      "base-body",
      "keyboard-key",
      "spacebar",
      "trackpad",
      "hinge-barrel",
      "screen-lid",
      "screen-display",
      "webcam",
      "usb-c-port-left",
      "usb-a-port",
      "hdmi-port",
      "vent-grille-left"
    ],
    "qualityChecks": [
      "键盘重复阵列必须保持在机身顶板范围内，不能穿出底座边缘。",
      "屏幕、边框和摄像头应跟随相近的屏幕倾角，不能与底座错位脱离。",
      "接口、散热栅格和脚垫应贴合机身侧面或底面，不应漂浮在模型外部。",
      "桌面接触锚点应位于底部脚垫附近，屏幕中心锚点应位于显示区域中央。"
    ],
    "commonVariants": [
      "轻薄本：降低 base-body 高度、缩小接口数量并减弱散热栅格。",
      "工程工作站：加厚 base-body、增加左右散热栅格和接口数量。",
      "演示状态：调大 screen-lid 的打开角度，并提高 screen-display 的 glow。"
    ]
  },
  "parameters": {
    "bodySize": { "type": "vec3", "unit": "m", "default": [0.36, 0.022, 0.25] },
    "screenSize": { "type": "vec3", "unit": "m", "default": [0.35, 0.23, 0.012] },
    "keyCount": { "type": "integer", "default": 71 }
  },
  "dependencies": [
    "primitive.box@0.1.0",
    "primitive.cylinder@0.1.0",
    "primitive.sphere@0.1.0",
    "spatial.linear-repeat@0.1.0",
    "spatial.grid-repeat@0.1.0"
  ],
  "editor": {
    "document": {
      "id": "laptop",
      "title": "笔记本电脑",
      "component": "core.composition",
      "parameters": {
        "nodes": [
