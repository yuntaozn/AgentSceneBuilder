          { "id": "usb-a-port", "parent": "laptop", "semanticType": "electronics.laptop.port.usb-a", "geometry": { "type": "box", "size": [0.012, 0.006, 0.014] }, "transform": { "position": [0.183, 0.011, -0.02] }, "appearance": { "color": "#0a0c0e", "opacity": 1 } },
          { "id": "hdmi-port", "parent": "laptop", "semanticType": "electronics.laptop.port.hdmi", "geometry": { "type": "box", "size": [0.012, 0.006, 0.016] }, "transform": { "position": [0.183, 0.011, 0.02] }, "appearance": { "color": "#0a0c0e", "opacity": 1 } },
          { "id": "headphone-jack", "parent": "laptop", "semanticType": "electronics.laptop.port.audio", "geometry": { "type": "cylinder", "radius": 0.0035, "height": 0.006, "radialSegments": 12 }, "transform": { "position": [0.183, 0.011, 0.06], "rotation": [0, 0, 1.5708] }, "appearance": { "color": "#0a0c0e", "opacity": 1 } },
