          { "id": "power-button", "parent": "laptop", "semanticType": "electronics.laptop.power-button", "geometry": { "type": "cylinder", "radius": 0.006, "height": 0.002, "radialSegments": 16 }, "transform": { "position": [0.14, 0.026, -0.09] }, "appearance": { "color": "#3a3e45", "opacity": 1, "metalness": 0.4 } },
          { "id": "speaker-grille", "parent": "laptop", "semanticType": "electronics.laptop.speaker", "geometry": { "type": "box", "size": [0.06, 0.002, 0.008] }, "repetition": { "type": "linear", "count": 2, "start": [-0.14, 0.0255, -0.085], "step": [0.28, 0, 0] }, "appearance": { "color": "#1a1c20", "opacity": 0.7 } }
