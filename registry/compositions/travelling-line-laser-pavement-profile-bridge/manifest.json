{
  "schemaVersion": "0.1",
  "id": "instrument.travelling-line-laser-pavement-profile-bridge",
  "version": "0.1.0",
  "kind": "composition",
  "title": "横移线激光路面轮廓检测架",
  "summary": "带横向中空导轨、皮带导滑座、升降激光头、测距轮和铰接支腿的独立检测架。",
  "license": "Apache-2.0",
  "semanticType": "instrument.travelling-line-laser-pavement-profile-bridge",
  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "路面轮廓仪",
    "线激光",
    "laser-profilometer",
    "transverse-profile",
    "工程检测",
    "inspection"
  ],
  "anchors": [
    "crossbeam-origin",
    "profile-line",
    "contact-wheel"
  ],
  "ai": {
    "intent": "在道路检测模型中调用带横移轴的独立激光扫描仪，引用光学锚点和测距轮位置。",
    "editableParts": [
      "laser-travel",
      "sensor-height",
      "fold-legs"
    ],
    "qualityChecks": [
      "调高或横移时光轴始终竖直向下。",
      "固定导轨基准独立于滑座。",
      "支腿折叠和检测头运动可分开设置。"
    ]
  },
