{
  "schemaVersion": "0.1",
  "id": "mep.water-electric-rough-in-system",
  "version": "0.1.0",
  "kind": "composition",
  "title": "水电隐蔽工程管线系统",
  "summary": "从既有水电工艺教学课件抽取的数字化模型：包含冷热水管、强弱电管、墙顶面开槽、管卡、排水坡度、打压测试装置和可复用接口锚点。",
  "license": "Apache-2.0",
  "semanticType": "mep.water-electric-rough-in-system",
  "capabilities": ["path-edit", "edit-repetition", "drain-slope-check", "pressure-test-loop", "anchors", "inspect-structure", "material", "no-glb"],
  "tags": ["MEP", "水电", "隐蔽工程", "管线", "教学模型", "课件迁移"],
  "parameters": {
    "waterPipeRadius": { "type": "number", "unit": "m", "default": 0.055 },
    "conduitRadius": { "type": "number", "unit": "m", "default": 0.04 },
    "clipSpacing": { "type": "number", "unit": "m", "default": 0.7 },
    "drainMinSlope": { "type": "number", "default": 0.005 },
    "testPressureMpa": { "type": "number", "unit": "MPa", "default": 0.8 }
  },
  "dependencies": ["mep.pipe@0.1.0", "mep.pipe-clip@0.1.0", "mep.route-with-clips@0.1.0", "mep.drain-slope-check@0.1.0", "mep.pressure-test-loop@0.1.0"],
  "ai": {
    "intent": "给 Agent 一个完整、可编辑、无 GLB 的水电隐蔽工程基准模型，用于复用管线路径、管卡间距、排水坡度和打压测试结构。",
    "useWhen": [
      "需要创建住宅、教学或工程交底里的水电管线隐蔽工程模型。",
      "需要参考冷热水管、强弱电管、排水坡度和打压测试如何组合。",
      "需要把课件里的工艺经验抽成可编辑 CompositionSpec，而不是复制课件页面。"
    ],
    "avoidWhen": [
      "需要表达完整建筑房间、装修材质或真实 BIM 系统时，该模型只能作为轻量教学/说明基准。",
      "需要依据具体地区规范自动判定合规时，应额外接入专业规则，本条目只保留结构化几何和可检查参数。"
    ],
    "editableParts": ["cold-water", "hot-water", "strong-electric", "weak-electric", "floor-drain", "cold-water-clip", "hot-water-clip", "pressure-test", "distribution-box"],
    "qualityChecks": [
      "排水管 points 应按流向逐步下降，必要时用 mep.drain-slope-check 复核。",
      "管卡应通过 path repetition 保留间距规则，不要展开成大量无语义节点。",
      "打压测试软管端点应连接冷热水接口锚点，压力表应有可视读取位置。"
    ],
    "commonVariants": ["厨房水电隐蔽工程", "卫生间排水坡度模型", "冷热水打压测试", "强弱电分路敷设", "吊顶管线管卡布置"]
  },
