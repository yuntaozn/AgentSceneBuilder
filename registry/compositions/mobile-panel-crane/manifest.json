{
  "schemaVersion": "0.1",
  "id": "equipment.mobile-panel-crane",
  "version": "0.4.2",
  "kind": "composition",
  "title": "移动式施工吊机",
  "summary": "只表达吊机本体的程序化机械模型，使用清晰的移动底盘、支腿、回转上车、立柱、简化桁架吊臂、卷扬机构、端部滑轮、吊线和吊钩表达完整机械关系。",
  "license": "Apache-2.0",
  "semanticType": "equipment.mobile-crane",
  "capabilities": ["articulated-hierarchy", "animate", "lifting-points", "inspect-structure", "stabilizer-footing", "no-glb"],
  "tags": ["施工机械", "吊机", "移动式设备", "程序化模型", "无GLB"],
  "ai": {
    "intent": "提供一个可解释、可编辑的移动式施工吊机数字模型，重点表达吊机作为完整机械对象的底盘稳定、回转、臂架、卷扬与吊点关系，而不是表达被吊物或施工场景。",
    "useWhen": [
      "需要施工设备、吊装工艺、装配式构件安装或机械安全教学中的移动式吊机对象。",
      "需要参考如何用层级节点表达底盘、上车、臂架、吊线和吊钩之间的运动关系。",
      "需要可继续调整吊臂长度、吊线长度、支腿展开宽度或吊点位置的程序化模型。"
    ],
    "avoidWhen": [
      "需要汽车起重机、塔吊或履带吊的完整真实机械结构。",
      "需要液压管路、发动机内部、真实钢丝绳绕组或制造级桁架节点细节。",
      "需要同时表达被吊墙板、吊带或现场环境；这些应作为独立模型组合。"
    ],
    "editableParts": [
      "base",
      "left-wheel",
      "right-wheel",
      "outrigger",
      "jack-post",
      "turntable",
      "upper",
      "counterweight",
      "mast",
      "boom-pivot",
      "boom",
      "tip-sheave",
      "winch-drum",
      "hook-line",
      "hook"
    ],
    "qualityChecks": [
      "hook-line 的起点必须与 boom 的远端端点一致，避免吊线从臂架中段或空中漂出。",
      "吊钩和滑轮应跟随 boom-pivot 父节点运动，保证 boom-lift 动画时吊点关系保持稳定。",
      "支腿和支脚只表达吊机自身稳定结构，不应包含墙板、吊带或施工物料。",
      "底盘、轮组、回转上车、配重和立柱应形成清晰的机械层级，不能混成单个不可编辑大块。"
    ],
    "commonVariants": [
      "小型室内吊机：缩短 boom、降低 mast，并减少支腿展开宽度。",
      "重载型吊机：加大 counterweight、base 和 jack-foot-pad，增加 boom-brace 数量。",
      "运输状态：降低 boom-pivot 旋转角度并缩短 hook-line。"
    ]
  },
  "parameters": {
    "boomLength": { "type": "number", "unit": "m", "default": 5.4 },
    "hookLength": { "type": "number", "unit": "m", "default": 2.1 },
    "outriggerSpan": { "type": "number", "unit": "m", "default": 4.4 }
  },
  "dependencies": [],
