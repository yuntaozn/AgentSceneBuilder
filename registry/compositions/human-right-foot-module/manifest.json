{
  "schemaVersion": "0.1",
  "id": "character.human-right-foot-module",
  "version": "0.1.0",
  "kind": "composition",
  "title": "人体右脚子构件",
  "summary": "由参数化几何生成的可编辑右脚与工靴模块，包含脚踝、轴向 loft 靴体、鞋头、鞋底、鞋带与地面接触锚点，可作为完整数字人或施工角色的脚部子构件复用。",
  "license": "Apache-2.0",
  "semanticType": "character.human.part.foot.right",
  "capabilities": [
    "inspect-structure",
    "anchors",
    "human-part",
    "human-foot-module",
    "axis-lofted-footwear",
    "foot-contact-anchor",
    "boot-layer",
    "no-glb"
  ],
  "tags": [
    "人物",
    "脚",
    "右脚",
    "工靴",
    "地面接触点",
    "参数化模型",
    "无GLB"
  ],
  "parameters": {
    "height": {
      "type": "number",
      "unit": "m",
      "default": 1.74
    },
    "part": {
      "type": "enum",
      "values": [
        "foot"
      ],
      "default": "foot"
    },
    "side": {
      "type": "enum",
      "values": [
        "right"
      ],
      "default": "right"
    }
  },
  "dependencies": [
    "character.human-surface-lowpoly@0.1.0",
    "primitive.box@0.1.0",
    "primitive.lofted-surface@0.1.0"
  ],
  "ai": {
    "intent": "给 Agent 一个可单独复用的人体脚部/工靴数字构件，用轴向 loft 表达鞋体和地面接触，而不是盒子加球形鞋头。",
    "useWhen": [
      "需要让人形角色站在地面、踏板、设备平台或施工场景中时使用。",
      "需要单独检查脚底接触、工靴鞋体、鞋带和朝向时使用。"
    ],
    "avoidWhen": [
      "需要真实鞋面纹理、软体鞋带、足部解剖或运动鞋高精模型时不要把它当最终资产。"
    ],
    "editableParts": [
      "right-foot-root",
      "right-ankle-pivot",
      "right-shoe",
      "right-toe-cap",
      "right-boot-sole",
      "right-boot-lace-a",
      "right-boot-lace-b"
    ],
    "qualityChecks": [
      "鞋体应沿脚长方向 loft，不应退回简单盒子。",
      "foot-contact 锚点必须保持在鞋底下方，方便放置到地面或设备踏板。"
    ],
    "commonVariants": [
      "工人右脚",
      "设备操作员右脚",
      "站立角色地面接触脚"
    ]
  },
  "visibility": "internal",
