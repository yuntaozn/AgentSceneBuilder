{
  "schemaVersion": "0.1",
  "id": "character.human-right-hand-module",
  "version": "0.1.0",
  "kind": "composition",
  "title": "人体右手子构件",
  "summary": "由参数化几何生成的可编辑右手模块，包含手腕、袖口、手掌、拇指、四指、指尖与抓取锚点，可作为完整数字人或设备操作场景中的手部子构件复用。",
  "license": "Apache-2.0",
  "semanticType": "character.human.part.hand.right",
  "capabilities": [
    "inspect-structure",
    "anchors",
    "human-part",
    "human-hand-module",
    "semantic-fingers",
    "finger-chain",
    "finger-pivots",
    "fine-hand-anchors",
    "section-loft-hands",
    "grasp-pose-ready",
    "no-glb"
  ],
  "tags": [
    "人物",
    "手",
    "右手",
    "手指",
    "抓取锚点",
    "参数化模型",
    "无GLB"
  ],
  "parameters": {
    "height": {
      "type": "number",
      "unit": "m",
      "default": 1.74
    },
    "part": {
      "type": "enum",
      "values": [
        "hand"
      ],
      "default": "hand"
    },
    "side": {
      "type": "enum",
      "values": [
        "right"
      ],
      "default": "right"
    }
  },
  "dependencies": [
    "character.human-surface-lowpoly@0.1.0",
    "character.human-pose-rig@0.1.0",
    "primitive.sphere@0.1.0",
    "primitive.box@0.1.0",
    "primitive.cylinder@0.1.0"
  ],
  "ai": {
    "intent": "给 Agent 一个可单独复用的人体手部数字构件，保留手掌、拇指、四指、指尖和抓取锚点，减少每次重写手指结构的工作。",
    "useWhen": [
      "需要表达抓取、指向、操作按钮、握持工具等手部动作前的基础几何时使用。",
      "需要把手作为独立模块放到机械臂、人形角色或教学示意中时使用。"
    ],
    "avoidWhen": [
      "需要真实皮肤褶皱、指甲、手掌纹理或完整手部骨骼蒙皮时不要把它当最终高精模型。"
    ],
    "editableParts": [
      "right-hand-root",
      "right-wrist-pivot",
      "right-sleeve-cuff",
      "right-hand",
      "right-thumb-pivot",
      "right-thumb",
      "right-index-finger",
      "right-middle-finger",
      "right-ring-finger",
      "right-little-finger"
    ],
    "qualityChecks": [
      "手指应保持语义链和指尖锚点，不能合并成一个不可编辑整体。",
      "手掌应使用掌形轮廓，不应退回球体或方块。"
    ],
    "commonVariants": [
      "右手抓取姿态基础",
      "右手指向姿态基础",
      "戴手套工人右手"
    ]
  },
  "visibility": "internal",
