  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "下吸式工位台",
    "焊烟工作台",
    "downdraft-table",
    "filter-drawer",
    "工位通风",
    "local-extraction"
  ],
  "anchors": [
    "work-surface",
    "exhaust",
    "filter-handle"
  ],
  "ai": {
    "intent": "在工作区调用具备下吸排风接口的工作台，表达栅面、可抽滤芯和敞口布置。",
    "editableParts": [
      "filter-withdrawal",
      "splash-angle"
    ],
    "qualityChecks": [
      "网面实际开放，进气空间位于滤盒上方。",
      "排气口在翻板和检修时位置固定。",
      "滤盒能独立抽出。"
    ]
  },
