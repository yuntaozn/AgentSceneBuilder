{
  "schemaVersion": "0.1",
  "id": "electronics.keyboard",
  "version": "0.3.1",
  "kind": "composition",
  "title": "桌面键盘",
  "summary": "完全由参数化几何组成的桌面键盘模型，表达外壳底座、主键区阵列、功能键、数字键区、方向键、空格键、指示灯和连接线。",
  "license": "Apache-2.0",
  "semanticType": "electronics.input.keyboard",
  "capabilities": [
    "inspect-layout",
    "edit-repetition",
    "key-grid",
    "anchors",
    "material",
    "no-glb"
  ],
  "tags": [
    "电子设备",
    "键盘",
    "输入设备",
    "键帽阵列",
    "参数化模型",
    "无GLB"
  ],
  "ai": {
    "intent": "提供一个按实际键盘分区组织的可编辑键盘结构参考，重点表达键区、行错位、宽键和重复键帽关系。",
    "useWhen": [
      "需要桌面外设、办公设备或人机交互场景中的键盘对象。",
      "需要参考如何用 repetition 和少量特殊键表达键盘布局。"
    ],
    "avoidWhen": [
      "需要真实键帽文字、机械轴结构或特定品牌键盘外观。",
      "需要 ISO/JIS 等精确物理键位标准。"
    ],
    "editableParts": [
      "main-key",
      "home-row-key",
      "bottom-letter-key",
      "number-row-key",
      "spacebar",
      "numeric-key",
      "arrow-key"
    ],
    "qualityChecks": [
      "最后一排键不得越过键盘底座。",
      "非装饰性键帽之间不得发生平面重叠。",
      "主键区、导航区和数字小键盘之间应保留明显分区间距。"
    ],
    "commonVariants": [
      "紧凑键盘：删除 numeric-key、numpad-zero-key、numpad-plus-key 和 numpad-enter-key。",
      "无线键盘：删除 cable-grommet、usb-cable 和 usb-plug。"
    ]
  },
  "parameters": {
    "mainKeyRows": {
      "type": "integer",
      "default": 4
    },
    "mainKeyColumns": {
      "type": "integer",
      "default": 12
    },
    "numericKeyColumns": {
      "type": "integer",
      "default": 4
    }
  },
  "dependencies": [
    "primitive.box@0.1.0",
    "primitive.sphere@0.1.0",
    "spatial.grid-repeat@0.1.0",
    "spatial.linear-repeat@0.1.0"
  ],
