{
  "schemaVersion": "0.1",
  "id": "electronics.mouse",
  "version": "0.5.0",
  "kind": "composition",
  "title": "桌面鼠标",
  "summary": "完全由参数化几何组成的桌面鼠标模型，表达一体化弧形机身、左右键、滚轮、分割缝、侧键和短线缆。",
  "license": "Apache-2.0",
  "semanticType": "electronics.input.mouse",
  "capabilities": [
    "inspect-structure",
    "anchors",
    "hose-path",
    "material",
    "animate",
    "no-glb"
  ],
  "tags": [
    "电子设备",
    "鼠标",
    "输入设备",
    "曲面近似",
    "参数化模型",
    "无GLB"
  ],
  "ai": {
    "intent": "提供一个轻量、可编辑的桌面鼠标结构参考，重点表达鼠标的整体轮廓和主要交互部件，而不是追求高拟真工业设计曲面。",
    "useWhen": [
      "需要在办公桌面、设备清单或教学场景中快速放置可解释鼠标对象。",
      "需要示范消费电子外壳可由参数化几何近似表达。"
    ],
    "avoidWhen": [
      "需要产品级高拟真外观、复杂人体工学曲面或真实制造倒角。",
      "需要展示底部传感器、脚垫等不可见结构细节。"
    ],
    "editableParts": [
      "body-shell",
      "left-button",
      "right-button",
      "scroll-wheel",
      "front-cable-grommet",
      "mouse-cable"
    ],
    "qualityChecks": [
      "主体应由连续圆润外壳主导，线缆不能拖大模型包围盒。",
      "常规视角下不应暴露底部传感器、脚垫或远端 USB 块。"
    ],
    "commonVariants": [
      "无线鼠标：删除 front-cable-grommet 和 mouse-cable。",
      "游戏鼠标：增加低透明侧键和顶部 DPI 键，但保持主体包围盒稳定。"
    ]
  },
  "parameters": {
    "bodyLength": {
      "type": "number",
      "unit": "m",
      "default": 0.096
    },
    "bodyWidth": {
      "type": "number",
      "unit": "m",
      "default": 0.055
    },
    "buttonCount": {
      "type": "integer",
      "default": 2
    }
  },
  "dependencies": [
    "primitive.sphere@0.1.0",
    "primitive.box@0.1.0",
    "primitive.cylinder@0.1.0",
    "primitive.torus@0.1.0"
  ],
