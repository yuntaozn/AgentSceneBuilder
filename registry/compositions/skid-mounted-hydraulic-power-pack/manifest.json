  "capabilities": [
    "attach",
    "inspect-structure",
    "set-pose"
  ],
  "tags": [
    "液压动力站",
    "液压油站",
    "hydraulic-power-pack",
    "fluid-power",
    "施工设备",
    "equipment"
  ],
  "anchors": [
    "pressure-out",
    "tank-return",
    "fill",
    "base"
  ],
  "ai": {
    "intent": "在液压设备装配中调用独立动力站和压力、回油接口。",
    "editableParts": [
      "tank-inspection",
      "valve-angle"
    ],
    "qualityChecks": [
      "固定橇架和外部液压接口保持静止。",
      "油箱盖与换向阀分别可编辑。",
      "箱体开盖后可查看内壁与储油空腔。"
    ]
  },
